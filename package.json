{
  "name": "games-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --no-env-file --watch src/index.ts",
    "start": "bun --no-env-file dist/index.js",
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.check.json",
    "commands": "bun --no-env-file scripts/register-commands.ts",
    "emojis": "bun --no-env-file scripts/sync-emojis.ts",
    "doctor": "bun --no-env-file scripts/doctor.ts",
    "data:snapshot": "bun --no-env-file scripts/snapshot-data.ts",
    "test:security": "bun --no-env-file test --timeout 30000 tests/*.test.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "chess.js": "^1.4.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@napi-rs/canvas",
    "sharp"
  ]
}
