{
  "name": "games-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "commands": "tsx scripts/register-commands.ts",
    "emojis": "tsx scripts/sync-emojis.ts",
    "doctor": "tsx scripts/doctor.ts",
    "data:snapshot": "tsx scripts/snapshot-data.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
